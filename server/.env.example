# ==========================================
# SmartFix Backend Environment Variables (Template)
# ==========================================

# Server Port
PORT=5000

# Environment: 'development' or 'production'
NODE_ENV=development

# Allowed Client Origin for CORS (comma-separated if multiple)
CLIENT_URL=http://localhost:5173,https://nguyenkhacquangkhanh22-design.github.io

# Rate Limiting (Requests per window per IP: 900000ms = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security Key for Admin endpoints
ADMIN_API_KEY=your_secure_admin_api_key_here
